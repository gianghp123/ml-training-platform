# NestJS API
NODE_ENV=development
PORT=3001
SWAGGER_USER=admin
SWAGGER_PASSWORD=change-me

# Clerk (copy the relevant values into apps/services/api/.env and apps/web/.env.local)
CLERK_SECRET_KEY=sk_test_replace_me
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# Next.js server-side API client
API_URL=http://localhost:3001/v1
API_KEY=local-development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=training_ml
DB_PASSWORD=training_ml
DB_NAME=training_ml

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# MinIO
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=training-ml
MINIO_CORS_ALLOW_ORIGIN=http://localhost:3000

# Cross-language workflow execution streams
WORKFLOW_JOB_STREAM=ml:workflow:jobs
WORKFLOW_CONSUMER_GROUP=python-workers
WORKFLOW_EVENT_STREAM_PREFIX=ml:workflow:runs
WORKER_POLL_MS=5000
EVENT_STREAM_MAXLEN=10000
EVENT_STREAM_TTL_SECONDS=86400
